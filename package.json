{
  "name": "expo-app-template",
  "version": "1.0.0",
  "private": true,
  "description": "Production-ready, feature-based Expo (SDK 57) starter with onboarding, auth, paywall, home and settings.",
  "license": "MIT",
  "main": "expo-router/entry",
  "scripts": {
    "dev": "expo start --dev-client",
    "start": "expo start",
    "android": "expo run:android",
    "ios": "expo run:ios",
    "typecheck": "tsc --noEmit",
    "lint": "oxlint --type-aware",
    "lint:fix": "oxlint --type-aware --fix",
    "format": "oxfmt",
    "format:check": "oxfmt --check",
    "knip": "knip",
    "check": "bun run typecheck && bun run lint && bun run format:check && bun run knip",
    "prepare": "lefthook install",
    "analyze": "EXPO_ATLAS=1 expo export --platform ios",
    "export:size": "EXPO_UNSTABLE_METRO_OPTIMIZE_GRAPH=1 EXPO_UNSTABLE_TREE_SHAKING=1 expo export --platform ios"
  },
  "dependencies": {
    "@posthog/react-native-plugin": "^2.6.0",
    "@react-native-async-storage/async-storage": "^3.1.1",
    "@react-native-picker/picker": "2.11.4",
    "@supabase/supabase-js": "^2.110.7",
    "@tanstack/react-query": "^5.101.2",
    "expo": "~57.0.21",
    "expo-apple-authentication": "~57.0.1",
    "expo-application": "~57.0.2",
    "expo-constants": "~57.0.17",
    "expo-crypto": "~57.0.2",
    "expo-dev-client": "~57.0.18",
    "expo-device": "~57.0.1",
    "expo-file-system": "~57.0.6",
    "expo-font": "~57.0.3",
    "expo-glass-effect": "~57.0.2",
    "expo-haptics": "~57.0.2",
    "expo-linear-gradient": "~57.0.1",
    "expo-linking": "~57.0.9",
    "expo-localization": "~57.0.1",
    "expo-notifications": "~57.0.17",
    "expo-router": "~57.0.20",
    "expo-secure-store": "~57.0.3",
    "expo-splash-screen": "~57.0.8",
    "expo-status-bar": "~57.0.1",
    "expo-symbols": "~57.0.2",
    "expo-system-ui": "~57.0.3",
    "expo-updates": "~57.0.21",
    "expo-web-browser": "~57.0.1",
    "posthog-react-native": "^4.68.7",
    "react": "^19.2.7",
    "react-dom": "^19.2.7",
    "react-native": "0.86.3",
    "react-native-gesture-handler": "^3.1.0",
    "react-native-purchases": "^10.9.1",
    "react-native-purchases-ui": "^10.9.1",
    "react-native-reanimated": "^4.5.2",
    "react-native-safe-area-context": "^5.8.0",
    "react-native-screens": "^4.26.2",
    "react-native-svg": "^15.15.5",
    "react-native-url-polyfill": "^4.0.0",
    "react-native-web": "~0.21.0",
    "react-native-worklets": "0.10.1",
    "zustand": "^5.0.14"
  },
  "devDependencies": {
    "@types/react": "~19.2.2",
    "eslint-plugin-expo": "^1.1.0",
    "eslint-plugin-react-hooks": "^7.1.1",
    "eslint-plugin-react-native": "^5.0.0",
    "eslint-plugin-react-native-a11y": "^3.5.1",
    "expo-atlas": "^0.4.0",
    "knip": "^6.35.1",
    "lefthook": "^2.1.12",
    "oxfmt": "0.67.0",
    "oxlint": "1.82.0",
    "oxlint-plugin-react-doctor": "^0.9.13",
    "oxlint-tsgolint": "7.0.2001",
    "typescript": "~6.0.3",
    "ultracite": "7.11.1"
  },
  "engines": {
    "node": ">=20"
  },
  "expo": {
    "install": {
      "exclude": [
        "react",
        "react-dom",
        "react-native-reanimated",
        "react-native-safe-area-context",
        "react-native-screens",
        "react-native-svg",
        "@react-native-async-storage/async-storage",
        "react-native-gesture-handler"
      ]
    }
  }
}
