{
  "name": "expo-app-template",
  "version": "1.0.0",
  "private": true,
  "description": "Production-ready, feature-based Expo (SDK 58) starter with onboarding, auth, paywall, home and settings.",
  "license": "MIT",
  "main": "expo-router/entry",
  "scripts": {
    "dev": "expo start --dev-client",
    "start": "expo start",
    "android": "expo run:android",
    "ios": "expo run:ios",
    "typecheck": "tsc --noEmit",
    "lint": "oxlint --type-aware",
    "lint:fix": "oxlint --type-aware --fix",
    "format": "oxfmt",
    "format:check": "oxfmt --check",
    "knip": "knip",
    "check": "bun run typecheck && bun run lint && bun run format:check && bun run knip",
    "prepare": "lefthook install",
    "analyze": "EXPO_ATLAS=1 expo export --platform ios",
    "export:size": "EXPO_UNSTABLE_METRO_OPTIMIZE_GRAPH=1 EXPO_UNSTABLE_TREE_SHAKING=1 expo export --platform ios"
  },
  "dependencies": {
    "@posthog/react-native-plugin": "^2.13.0",
    "@react-native-async-storage/async-storage": "^3.1.1",
    "@react-native-picker/picker": "2.11.4",
    "@supabase/supabase-js": "^2.119.0",
    "@tanstack/react-query": "^5.107.1",
    "expo": "~58.0.23",
    "expo-apple-authentication": "~58.0.2",
    "expo-application": "~58.1.2",
    "expo-constants": "~58.0.15",
    "expo-crypto": "~58.0.7",
    "expo-dev-client": "~58.0.18",
    "expo-device": "~58.0.5",
    "expo-file-system": "~58.0.13",
    "expo-font": "~58.0.11",
    "expo-glass-effect": "~58.0.5",
    "expo-haptics": "~58.0.7",
    "expo-linear-gradient": "~58.0.3",
    "expo-linking": "~58.0.16",
    "expo-localization": "~58.0.5",
    "expo-notifications": "~58.1.8",
    "expo-router": "~58.0.30",
    "expo-secure-store": "~58.0.2",
    "expo-splash-screen": "~58.0.13",
    "expo-status-bar": "~58.0.4",
    "expo-symbols": "~58.0.4",
    "expo-system-ui": "~58.0.7",
    "expo-updates": "~58.0.21",
    "expo-web-browser": "~58.0.7",
    "posthog-react-native": "^4.85.3",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "react-native": "0.88.1",
    "react-native-gesture-handler": "^3.3.0",
    "react-native-purchases": "^11.0.1",
    "react-native-purchases-ui": "^11.0.1",
    "react-native-reanimated": "^4.7.1",
    "react-native-safe-area-context": "^5.11.1",
    "react-native-screens": "^4.30.1",
    "react-native-svg": "^15.16.0",
    "react-native-url-polyfill": "^4.0.0",
    "react-native-web": "~0.21.4",
    "react-native-worklets": "0.13.0",
    "zustand": "^5.1.0"
  },
  "devDependencies": {
    "@types/react": "~19.3.0",
    "eslint-plugin-expo": "^1.2.1",
    "eslint-plugin-react-hooks": "^7.1.1",
    "eslint-plugin-react-native": "^5.0.0",
    "eslint-plugin-react-native-a11y": "^3.5.1",
    "expo-atlas": "^0.5.0",
    "knip": "^6.44.2",
    "lefthook": "^2.2.2",
    "oxfmt": "0.77.0",
    "oxlint": "1.92.0",
    "oxlint-plugin-react-doctor": "^0.9.22",
    "oxlint-tsgolint": "7.0.2006",
    "typescript": "~6.0.3",
    "ultracite": "8.1.1"
  },
  "overrides": {
    "expo-server@57": "^58.0.6",
    "glob@13": "^14.0.4",
    "minimatch@10": "11.0.5"
  },
  "engines": {
    "node": ">=20"
  },
  "expo": {
    "install": {
      "exclude": [
        "react",
        "react-dom",
        "react-native-reanimated",
        "react-native-safe-area-context",
        "react-native-screens",
        "react-native-svg",
        "@react-native-async-storage/async-storage",
        "react-native-gesture-handler"
      ]
    }
  }
}
